# Dependency directories
node_modules/

# Next.js build output
.next/
out/

# Production build output
build/
dist/

# OS metadata files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment local files
.env*.local

# Vercel
.vercel

# TypeScript build info & caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
