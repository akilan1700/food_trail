# File: backend/.gitignore
# Description: Git ignore patterns for backend Node/Express application
# Author: Akilan M
# Created: 2026-08-11T17:56:00+05:30

# Dependency directories
node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul or Jest
coverage/
*.lcov

# OS files
.DS_Store
Thumbs.db
