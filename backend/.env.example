# File: backend/.env.example
# Description: Example environment variables for the FoodTrail backend (no secrets).
# Author: Akilan M
# Updated: 2026-09-11

NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/foodtrail
JWT_SECRET=replace-with-long-random-string
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=FoodTrail
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_MPIN=
ADMIN_NAME=FoodTrail Administrator
